# Vasooli runs fully offline with no environment variables set at all —
# every provider below falls back to a deterministic, seeded fake. Drop
# real credentials in here to flip the corresponding adapter to live with
# no code changes anywhere (see @vasooli/llm's and @vasooli/razorpay's
# createXxxProvider() factories, and docs/adr/0005-offline-first-provider-abstraction.md).

# --- LLM diagnosis + content generation ---
# Presence wins in this order: GROQ_API_KEY > OPENAI_API_KEY > MockLlmProvider (offline).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Razorpay payment actions ---
# Both must be set to flip to the live client; otherwise FakeRazorpayClient (offline).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- apps/engine ---
PORT=4000

# --- apps/web ---
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
